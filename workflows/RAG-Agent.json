    {
      "parameters": {
        "jsCode": "return [\n  // pro Kriterium eigener Eintrag mit anchor\n  {\n    json: {\n      url: \"https://www.w3.org/TR/WCAG22/\",\n      doc_type: \"spec\",\n      criterion_id: \"2.5.8\",\n      wcag_version: \"2.2\",\n      anchor: \"#target-size-minimum\"\n    }\n  },\n  {\n    json: {\n      url: \"https://www.w3.org/TR/WCAG22/\",\n      doc_type: \"spec\",\n      criterion_id: \"2.4.11\",\n      wcag_version: \"2.2\",\n      anchor: \"#focus-not-obscured-minimum\"\n    }\n  },\n  {\n    json: {\n      url: \"https://www.w3.org/TR/WCAG22/\",\n      doc_type: \"spec\",\n      criterion_id: \"3.3.8\",\n      wcag_version: \"2.2\",\n      anchor: \"#accessible-authentication-minimum\"\n    }\n  },\n\n  // Understanding\n  {\n    json: {\n      url: \"https://www.w3.org/WAI/WCAG22/Understanding/target-size-minimum.html\",\n      doc_type: \"understanding\",\n      criterion_id: \"2.5.8\",\n      wcag_version: \"2.2\",\n      anchor: null\n    }\n  },\n  {\n    json: {\n      url: \"https://www.w3.org/WAI/WCAG22/Understanding/focus-not-obscured-minimum.html\",\n      doc_type: \"understanding\",\n      criterion_id: \"2.4.11\",\n      wcag_version: \"2.2\",\n      anchor: null\n    }\n  },\n  {\n    json: {\n      url: \"https://www.w3.org/WAI/WCAG22/Understanding/accessible-authentication.html\",\n      doc_type: \"understanding\",\n      criterion_id: \"3.3.8\",\n      wcag_version: \"2.2\",\n      anchor: null\n    }\n  },\n\n  // Quickref\n  {\n    json: {\n      url: \"https://www.w3.org/WAI/WCAG22/quickref/\",\n      doc_type: \"how_to_meet\",\n      criterion_id: null,\n      wcag_version: \"2.2\",\n      anchor: null\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        64,
        1312
      ],
      "id": "a1a80631-2197-46f6-abe7-41fd497f4321",
      "name": "URL-Liste"
    },
    {
