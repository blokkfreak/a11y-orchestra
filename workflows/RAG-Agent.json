        "options": {}
      },
      "id": "ba34e343-75fa-4f05-a22a-36f37e3d0282",
      "name": "Request W3C",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        256,
        1312
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const html = item.json.data || \"\";\n\n  if (typeof html !== 'string') {\n    throw new Error('Erwarte in item.json.data einen String, habe bekommen: ' + typeof html);\n  }\n\n  const text = html\n    .replace(/<script[\\s\\S]*?<\\/script>/gi, \" \")\n    .replace(/<style[\\s\\S]*?<\\/style>/gi, \" \")\n    .replace(/<[^>]+>/g, \" \")\n    .replace(/&nbsp;/g, \" \")\n    .replace(/&amp;/g, \"&\")\n    .replace(/&lt;/g, \"<\")\n    .replace(/&gt;/g, \">\")\n    .replace(/\\s+/g, \" \")\n    .trim();\n\n  return {\n    json: {\n      text,\n      url: $('URL-Liste').first().json.url,\n      doc_type: $('URL-Liste').first().json.doc_type,\n      criterion_id: $('URL-Liste').first().json.criterion_id,\n      wcag_version: $('URL-Liste').first().json.wcag_version,\n      anchor: $('URL-Liste').first().json.anchor\n\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        1312
      ],
      "id": "d294462a-154d-4b96-bb9b-f14fd1b31dd0",
      "name": "HTML zu Text"
